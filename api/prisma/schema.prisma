generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  cpf String? @unique
  phone String?
  address String?
  role String @default("OWNER")
  listings Listing[]
  uploads ImageUpload[]
  partner Partner?
  createdAt DateTime @default(now())
}
model Listing {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  title String
  description String
  type String
  purpose String
  city String
  neighborhood String
  privateAddress String
  ownerPhone String
  price Int
  area Float
  bedrooms Int @default(0)
  images String[]
  uploads ImageUpload[]
  status String @default("PENDING")
  reviewed Boolean @default(false)
  paidAt DateTime?
  expiresAt DateTime?
  adPrice Int
  plan String @default("BASIC")
  durationDays Int
  commissionBps Int
  termsVersion String
  acceptedAt DateTime
  termsText String @db.Text
  paymentId String? @unique
  checkoutUrl String?
  couponId String?
  coupon Coupon? @relation(fields: [couponId], references: [id])
  couponCode String?
  originalAdPrice Int?
  partnerReward Int @default(0)
  partnerHoldDays Int @default(0)
  affiliateVoidedAt DateTime?
  affiliateEntries AffiliateEntry[]
  leads Lead[]
  deal Deal?
  createdAt DateTime @default(now())
  @@index([status, expiresAt])
  @@index([couponId, paidAt])
}
model Lead {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id])
  name String
  phone String
  message String
  stage String @default("NEW")
  visitAt DateTime?
  notes String @default("")
  consentAt DateTime
  createdAt DateTime @default(now())
}
model Deal {
  id String @id @default(cuid())
  listingId String @unique
  listing Listing @relation(fields: [listingId], references: [id])
  buyerName String
  sellerName String
  finalPrice Int
  commission Int
  commissionPaid Boolean @default(false)
  paymentTerms String
  createdAt DateTime @default(now())
}
model Audit {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String
  detail String
  createdAt DateTime @default(now())
}

model ImageUpload {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listingId String?
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  data Bytes
  mimeType String
  createdAt DateTime @default(now())
  @@index([ownerId, listingId])
}

model CommercialSettings {
  id String @id @default("main")
  saleCommissionBps Int
  rentCommissionBps Int
  enabled Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model Partner {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  active Boolean @default(true)
  minWithdrawal Int
  coupons Coupon[]
  entries AffiliateEntry[]
  payouts PartnerPayout[]
  createdAt DateTime @default(now())
}

model Coupon {
  id String @id @default(cuid())
  code String @unique
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  active Boolean @default(true)
  discountCents Int
  rewardCents Int
  holdDays Int
  plans String[]
  expiresAt DateTime
  maxUses Int?
  reservations Int @default(0)
  listings Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  termsUpdatedAt DateTime @default(now())
}

// Lançamentos com sinal: crédito positivo; estorno negativo. Uma ocorrência
// por anúncio/tipo. Saques reservam os lançamentos dentro de transação serializável.
model AffiliateEntry {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  listingId String
  listing Listing @relation(fields: [listingId], references: [id])
  kind String
  amount Int
  availableAt DateTime
  payoutId String?
  payout PartnerPayout? @relation(fields: [payoutId], references: [id])
  createdAt DateTime @default(now())
  @@unique([listingId, kind])
  @@index([partnerId, payoutId, availableAt])
}

model PartnerPayout {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  requestKey String @unique
  amount Int
  status String @default("REQUESTED")
  pixKey String
  recipientName String
  receiptReference String?
  note String?
  entries AffiliateEntry[]
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([partnerId, status])
}
